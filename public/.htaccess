ErrorDocument 404 /uk/index.html

RewriteEngine On
RewriteBase /uk/

# 301: http -> https и www -> без www (одним переходом)
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://eco-consulting.com.ua%{REQUEST_URI} [R=301,L]

# реальные файлы (js, css, картинки, sitemap) отдаём как есть
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# существующие страницы SPA: index.html со статусом 200
RewriteRule ^(poslugy|pro-nas|litsenzii|kontaktu|politika-konfidentsiinosti)/?$ index.html [L]
RewriteRule ^poslugy/(povitrya|specvodokorystuvannya|otsinka-vplyvu-na-dovkillya|rozmischennya-vidhodiv|dozvil_obroblenja_vidhodiv|plan-upravlinja-vidhodami)/?$ index.html [L]

# всё остальное -> 404 (ErrorDocument отдаёт index.html со статусом 404,
# React показывает страницу NotFound)
